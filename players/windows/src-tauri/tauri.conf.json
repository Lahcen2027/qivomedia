{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qivomedia Player",
  "version": "0.1.0",
  "identifier": "com.qivomedia.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["setup-screen"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Qivomedia",
    "copyright": "© Qivomedia",
    "category": "Business",
    "shortDescription": "Qivomedia digital signage player",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "French", "Arabic"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["en-US", "fr-FR"]
      }
    }
  }
}
