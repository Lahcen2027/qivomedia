# Your domain. Its DNS A record (and www) must point to this server's IP before you start.
QIVO_DOMAIN=qivomedia.com

# Caddyfile = one domain for the app (self-hosted / university install).
# Caddyfile.saas = website on QIVO_DOMAIN + app on app.QIVO_DOMAIN (qivomedia.com).
CADDYFILE=Caddyfile

# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=admin@qivomedia.com

# 0 = only the first visitor can create an organization (recommended).
# 1 = anyone can sign up and create their own organization (SaaS mode).
QIVO_ALLOW_SIGNUP=0

RUST_LOG=qivo_server=info

# AI layout agent (optional). Create a key at https://console.anthropic.com
# Leave empty to hide the AI features everywhere.
ANTHROPIC_API_KEY=
# Model used by the AI agent.
QIVO_AI_MODEL=claude-sonnet-5-5

# Email (password resets, invitations, demo-request alerts). Any SMTP provider works:
# Brevo, Mailjet, Amazon SES, Google Workspace, Microsoft 365, your own server…
# Without SMTP_HOST nothing is sent and reset links are written to the server log.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | tls (port 465) | none
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Qivomedia <no-reply@qivomedia.com>
# Who receives new demo requests from the website (comma-separated). Default: all platform admins.
QIVO_NOTIFY_EMAIL=
# Base URL used in email links. Default: the address the request came in on.
QIVO_PUBLIC_URL=
